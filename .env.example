# List of Simplecast RSS Feed URLs for your 4 podcasts (comma-separated)
SIMPLECAST_RSS_URLS=https://feeds.simplecast.com/SHOW_1_ID,https://feeds.simplecast.com/SHOW_2_ID,https://feeds.simplecast.com/SHOW_3_ID,https://feeds.simplecast.com/SHOW_4_ID

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_free_gemini_api_key

# Number of episodes to market per GitHub Actions run (Default: 5 to stay within free limits)
BATCH_SIZE=5

# Delay in milliseconds between Gemini requests
RATE_LIMIT_DELAY_MS=3000

# Buffer API Access Token (Optional: Free plan for auto-scheduling posts)
BUFFER_ACCESS_TOKEN=your_buffer_access_token
BUFFER_PROFILE_IDS=profile_id_1,profile_id_2

# Telegram Bot (Optional: To receive marketing campaigns directly in Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Run in test mode without publishing
DRY_RUN=false
